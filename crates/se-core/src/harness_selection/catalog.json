{
  "qwen-code": {
    "title": "Qwen Code",
    "setup_url": "https://qwenlm.github.io/qwen-code-docs/en/users/quickstart/",
    "descriptor": {
      "driver": "acp-stdio",
      "command": "node",
      "arguments": [
        "--acp"
      ],
      "environment": [
        "OPENAI_API_KEY",
        "OPENAI_BASE_URL",
        "OPENAI_MODEL",
        "QWEN_HOME"
      ],
      "permissions": {
        "default": {
          "arguments": [],
          "environment": {},
          "mode": ""
        }
      },
      "model_arguments": [
        "--model",
        "{model}"
      ]
    },
    "package": {
      "name": "@qwen-code/qwen-code",
      "bin": "qwen"
    }
  },
  "goose": {
    "title": "Goose",
    "setup_url": "https://github.com/aaif-goose/goose/blob/main/documentation/docs/getting-started/installation.md",
    "descriptor": {
      "driver": "acp-stdio",
      "command": "goose",
      "arguments": [
        "acp",
        "--with-builtin",
        "developer"
      ],
      "environment": [
        "OPENAI_API_KEY",
        "OPENAI_BASE_URL",
        "GOOSE_PROVIDER",
        "GOOSE_PATH_ROOT",
        "GOOSE_DISABLE_KEYRING",
        "GOOSE_MODEL",
        "GOOSE_MODE"
      ],
      "model_environment": "GOOSE_MODEL",
      "permissions": {
        "default": {
          "arguments": [],
          "environment": {},
          "mode": ""
        }
      }
    },
    "package": null
  },
  "hermes": {
    "title": "Hermes",
    "setup_url": "https://hermes-agent.nousresearch.com/docs/getting-started/installation",
    "descriptor": {
      "driver": "acp-stdio",
      "command": "hermes",
      "arguments": [
        "acp"
      ],
      "environment": [
        "HERMES_HOME",
        "HERMES_MODEL"
      ],
      "model_environment": "HERMES_MODEL",
      "unadvertised_http_mcp": true,
      "permissions": {
        "default": {
          "arguments": [],
          "environment": {},
          "mode": ""
        }
      }
    },
    "package": null
  },
