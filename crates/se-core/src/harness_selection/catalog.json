{
  "qwen-code": {
    "title": "Qwen Code",
    "setup_url": "https://qwenlm.github.io/qwen-code-docs/en/users/quickstart/",
    "descriptor": {
      "driver": "acp-stdio",
      "command": "node",
      "arguments": [
        "--acp"
      ],
      "environment": [
        "OPENAI_API_KEY",
        "OPENAI_BASE_URL",
        "OPENAI_MODEL",
        "QWEN_HOME",
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_BASE_URL",
        "ANTHROPIC_MODEL",
        "GEMINI_API_KEY",
        "GEMINI_MODEL"
      ],
      "permissions": {
        "default": {
          "arguments": [],
          "environment": {},
          "mode": ""
        }
      },
      "model_arguments": [
        "--model",
        "{model}"
      ]
    },
    "package": {
      "name": "@qwen-code/qwen-code",
      "bin": "qwen"
    }
  },
  "goose": {
    "title": "Goose",
    "setup_url": "https://github.com/aaif-goose/goose/blob/main/documentation/docs/getting-started/installation.md",
