        "OPENAI_BASE_URL",
        "GOOSE_PROVIDER",
        "GOOSE_PATH_ROOT",
        "GOOSE_DISABLE_KEYRING",
        "GOOSE_MODEL",
        "GOOSE_MODE",
        "ANTHROPIC_API_KEY",
        "GOOGLE_API_KEY",
        "OPENROUTER_API_KEY"
      ],
      "model_environment": "GOOSE_MODEL",
      "permissions": {
        "default": {
          "arguments": [],
          "environment": {},
          "mode": ""
        }
      }
    },
    "package": null
  },
